dane <- read_csv("dane.csv")
dane
dane %>%
group_by(trudnosc) %>%
summarise(M = mean(pamiec), SD = sd(pamiec))
ggplot(data = dane, mapping = aes(x = trudnosc, y = pamiec)) +
geom_boxplot() +
geom_jitter(alpha = .3)
dane %>%
group_by(pobudzenie) %>%
summarise(M = mean(pamiec), SD = sd(pamiec))
ggplot(data = dane, mapping = aes(x = pobudzenie, y = pamiec)) +
geom_boxplot() +
geom_jitter(alpha = .3)
dane %>%
group_by(pobudzenie, trudnosc) %>%
summarise(M = mean(pamiec), SD = sd(pamiec))
ggplot(data = dane, mapping = aes(
x = pobudzenie,
y = pamiec,
color = trudnosc
)) +
geom_boxplot() +
geom_jitter(alpha = .5)
aov(pamiec ~ pobudzenie + trudnosc + pobudzenie:trudnosc, data = dane) %>%
summary()
aov(pamiec ~ pobudzenie + trudnosc + pobudzenie:trudnosc, data = dane) %>%
summary()
# post-hoc comparisons with Tukey HSD
TukeyHSD(anova_res)
anova_res <- aov(pamiec ~ pobudzenie + trudnosc + pobudzenie:trudnosc, data = dane)
summary(anova_res)
# post-hoc comparisons with Tukey HSD
TukeyHSD(anova_res)
# post-hoc comparisons with Tukey HSD
TukeyHSD(anova_res)
