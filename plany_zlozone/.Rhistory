lmer(wynik ~ pobudzenie + walencja + pobudzenie:walencja + (1|pid), data = df6) %>%
anova()
lmer_model <- lmer(wynik ~ pobudzenie + walencja + pobudzenie:walencja + (1|pid), data = df6)
anova(lmer_model)
TukeyHSD(lmer_model)
anova_lmer <- anova(lmer_model)
summary(anova_lmer)
anova_lmer
TukeyHSD(lmer_model)
anova_lmer <- anova(lmer_model)
library(emmeans)
lmer_model <- lmer(wynik ~ pobudzenie + walencja + pobudzenie:walencja + (1|pid), data = df6)
anova(lmer_model)
emm <- emmeans(lmer_model)
emm <- emmeans(lmer_model, pobudzenie*walencja)
emm <- emmeans(lmer_model, ~ pobudzenie*walencja)
pairs(emm)
emm <- emmeans(lmer_model, pairwise ~ pobudzenie*walencja)
contrast(emm)
emm <- emmeans(lmer_model, ~ pobudzenie*walencja)
contrast(emm)
pairs(emm)
pairs(emm, simple="each")
